(ns nonstoreops.sim
  "Demo driver -- `kbb -M:run`. Walks a clean sale/order-record
  logging request through intake -> advise -> govern -> decide ->
  approval -> commit at phase 1 (assisted-logging, always approval),
  then re-runs the same op at phase 3 (supervised-auto, clean + high
  confidence -> auto-commit), then a route/vending-machine-fleet-
  scheduling request and a low-cost supply-order coordination naming a
  verified vendor (both auto-commit clean at phase 3), then a high-cost
  supply-order (ALWAYS escalates regardless of phase), then a
  compliance-concern flag (ALWAYS escalates, at any phase -- approve,
  then commit), then HARD-hold scenarios: an unregistered seller, a
  seller registered but not yet verified, a supply-order naming an
  unverified vendor, a proposal whose own `:effect` is not `:propose`,
  and a proposal that has drifted into finalizing a waiver of a
  consumer's statutory cooling-off/cancellation right."
  (:require [langgraph.graph :as g]
            [nonstoreops.advisor :as advisor]
            [nonstoreops.store :as store]
            [nonstoreops.operation :as op]))

(defn- exec-op [actor tid request context]
  (g/run* actor {:request request :context context} {:thread-id tid}))

(defn- approve! [actor tid]
  (g/run* actor {:approval {:status :approved :by "nonstore-retail-coordinator-1"}} {:thread-id tid :resume? true}))

(defn -main [& _]
  (let [db (store/seed-db)
        coordinator-phase-1 {:actor-id "coord-1" :actor-role :nonstore-retail-coordinator :phase 1}
        coordinator-phase-3 {:actor-id "coord-1" :actor-role :nonstore-retail-coordinator :phase 3}
        actor (op/build db)]

    (println "== log-sales-record seller-1 (phase 1, escalates -- human approves) ==")
    (let [r (exec-op actor "t1" {:op :log-sales-record :seller-id "seller-1"
                                  :patch {:units-sold 12 :collections 5 :channel :door-to-door}} coordinator-phase-1)]
      (println r)
      (println "-- human non-store-retail coordinator approves --")
      (println (approve! actor "t1")))

    (println "\n== log-sales-record seller-1 (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t2" {:op :log-sales-record :seller-id "seller-1"
                                  :patch {:units-sold 8 :collections 3}} coordinator-phase-3))

    (println "\n== schedule-route-operation seller-2 (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t3" {:op :schedule-route-operation :seller-id "seller-2"
                                  :patch {:route "riverside-loop-4" :date "2026-07-20" :window "09:00-17:00"}} coordinator-phase-3))

    (println "\n== coordinate-supply-order seller-1, low cost, verified vendor (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t4" {:op :coordinate-supply-order :seller-id "seller-1"
                                  :patch {:item "door-to-door catalog restock" :quantity 100 :estimated-cost 380.0
                                          :vendor-id "vendor-1"}} coordinator-phase-3))

    (println "\n== coordinate-supply-order seller-2, HIGH cost (ALWAYS escalates, even at phase 3) ==")
    (let [r (exec-op actor "t5" {:op :coordinate-supply-order :seller-id "seller-2"
                                 :patch {:item "vending-machine unit fleet expansion" :quantity 6 :estimated-cost 4200.0
                                         :vendor-id "vendor-1"}} coordinator-phase-3)]
      (println r)
      (println "-- human non-store-retail coordinator reviews & approves --")
      (println (approve! actor "t5")))

    (println "\n== flag-compliance-concern seller-1 (ALWAYS escalates, even at phase 3) ==")
    (let [r (exec-op actor "t6" {:op :flag-compliance-concern :seller-id "seller-1"
                                 :patch {:concern "customer reports being pressured at the door and unsure how to exercise cooling-off cancellation" :confidence 0.92}} coordinator-phase-3)]
      (println r)
      (println "-- human non-store-retail coordinator reviews & approves --")
      (println (approve! actor "t6")))

    (println "\n== log-sales-record seller-99 (unregistered seller -> HARD hold) ==")
    (println (exec-op actor "t7" {:op :log-sales-record :seller-id "seller-99"
                                  :patch {:units-sold 0}} coordinator-phase-3))

    (println "\n== log-sales-record seller-3 (registered but unverified -> HARD hold) ==")
    (println (exec-op actor "t8" {:op :log-sales-record :seller-id "seller-3"
                                  :patch {:units-sold 4}} coordinator-phase-3))

    (println "\n== coordinate-supply-order seller-1, vendor-2 unverified (-> HARD hold) ==")
    (println (exec-op actor "t9" {:op :coordinate-supply-order :seller-id "seller-1"
                                  :patch {:item "import party-plan merchandise" :quantity 30 :estimated-cost 260.0
                                          :vendor-id "vendor-2"}} coordinator-phase-3))

    (println "\n== schedule-route-operation seller-1, advisor attempts direct actuation (:effect :commit) -> HARD hold ==")
    (let [actor-direct (op/build db {:advisor (reify advisor/Advisor
                                                (-advise [_ _ req]
                                                  (assoc (advisor/infer nil req) :effect :commit)))})]
      (println (exec-op actor-direct "t10" {:op :schedule-route-operation :seller-id "seller-1"
                                           :patch {:route "weekday-north-loop" :date "2026-07-22"}} coordinator-phase-3)))

    (println "\n== log-sales-record seller-1, advisor drifts into cooling-off-waiver-finalization scope -> HARD hold, permanent ==")
    (println (exec-op actor "t11" {:op :log-sales-record :seller-id "seller-1"
                                   :out-of-scope? true
                                   :patch {}} coordinator-phase-3))

    (println "\n== audit ledger ==")
    (doseq [f (store/ledger db)] (println f))

    (println "\n== committed coordination log ==")
    (doseq [r (store/coordination-log db)] (println r))))
